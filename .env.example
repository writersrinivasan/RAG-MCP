# Optional — leave everything unset to run the whole app in offline DEMO/MOCK mode.
# Set ONE provider to enable live LLM answers in the /api/chat endpoint.
# Put real values in .env.local (gitignored) — never commit a real key.

# --- Option A: Groq (fast, OpenAI-compatible) ---
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=openai/gpt-oss-120b   # pick any model your key can access

# --- Option B: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Advanced: override base URL / model for any OpenAI-compatible provider ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
